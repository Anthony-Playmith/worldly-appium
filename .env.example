# Copy to .env and fill in. Never commit .env.

# --- Supabase (same project the app uses: worldly/.env) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Secret (service role) key: used only by test setup/teardown to create and delete throwaway
# users and to inspect rows. Found in worldly/.env.local or Supabase -> Project Settings -> API keys.
SUPABASE_SECRET_KEY=

# --- Android ---
# Android SDK folder (adb lives in platform-tools)
ANDROID_HOME=C:\Users\<you>\AppData\Local\Android\Sdk
# APK to install before the UI run. Leave empty to test whatever Worldly build is already installed.
APP_PATH=apps/worldly.apk
# adb serial of the device to use (see `adb devices`). Empty = the only connected device.
DEVICE_UDID=
# Language the app runs in on the device (en, es, fr...). Empty = detect from the device.
APP_LANGUAGE=
# UI specs ERASE Worldly's data on the device before each spec (like a fresh install).
# Emulators are always allowed. On a real phone set this to true only if you accept that.
ALLOW_APP_DATA_RESET=false
